<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surface -->
    <Color x:Key="C.Bg">#0B0E14</Color>
    <Color x:Key="C.Surface">#11151D</Color>
    <Color x:Key="C.SurfaceAlt">#161B25</Color>
    <Color x:Key="C.SurfaceElevated">#1A2030</Color>
    <Color x:Key="C.Border">#1F2632</Color>
    <Color x:Key="C.BorderStrong">#2A3242</Color>
    <Color x:Key="C.Hover">#1E2533</Color>

    <!-- Text -->
    <Color x:Key="C.Text">#E6E8EE</Color>
    <Color x:Key="C.TextMuted">#8A93A6</Color>
    <Color x:Key="C.TextDim">#5C6678</Color>

    <!-- Brand -->
    <Color x:Key="C.Accent">#4F8CFF</Color>
    <Color x:Key="C.AccentDeep">#2563EB</Color>
    <Color x:Key="C.AccentSoft">#1A2A4A</Color>

    <!-- Semantic -->
    <Color x:Key="C.Ok">#10B981</Color>
    <Color x:Key="C.OkSoft">#0D2A24</Color>
    <Color x:Key="C.Warn">#F59E0B</Color>
    <Color x:Key="C.WarnSoft">#3A2A0D</Color>
    <Color x:Key="C.Down">#EF4444</Color>
    <Color x:Key="C.DownSoft">#3A1518</Color>
    <Color x:Key="C.Unknown">#6B7280</Color>
    <Color x:Key="C.UnknownSoft">#222731</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Bg"               Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="Brush.Surface"          Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt"       Color="{StaticResource C.SurfaceAlt}"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated"  Color="{StaticResource C.SurfaceElevated}"/>
    <SolidColorBrush x:Key="Brush.Border"           Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderStrong"     Color="{StaticResource C.BorderStrong}"/>
    <SolidColorBrush x:Key="Brush.Hover"            Color="{StaticResource C.Hover}"/>

    <SolidColorBrush x:Key="Brush.Text"             Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="Brush.TextMuted"        Color="{StaticResource C.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextDim"          Color="{StaticResource C.TextDim}"/>

    <SolidColorBrush x:Key="Brush.Accent"           Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentDeep"       Color="{StaticResource C.AccentDeep}"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"       Color="{StaticResource C.AccentSoft}"/>

    <SolidColorBrush x:Key="Brush.Ok"               Color="{StaticResource C.Ok}"/>
    <SolidColorBrush x:Key="Brush.OkSoft"           Color="{StaticResource C.OkSoft}"/>
    <SolidColorBrush x:Key="Brush.Warn"             Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="Brush.WarnSoft"         Color="{StaticResource C.WarnSoft}"/>
    <SolidColorBrush x:Key="Brush.Down"             Color="{StaticResource C.Down}"/>
    <SolidColorBrush x:Key="Brush.DownSoft"         Color="{StaticResource C.DownSoft}"/>
    <SolidColorBrush x:Key="Brush.Unknown"          Color="{StaticResource C.Unknown}"/>
    <SolidColorBrush x:Key="Brush.UnknownSoft"      Color="{StaticResource C.UnknownSoft}"/>

    <!-- Legacy aliases (kept so old refs in MainViewModel/etc. still resolve if any) -->
    <SolidColorBrush x:Key="BgBrush"     Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="CardBrush"   Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="TextBrush"   Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource C.Accent}"/>

</ResourceDictionary>
