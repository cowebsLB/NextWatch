<Window x:Class="NextWatch.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="720" Width="1100"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="NextWatch" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="{Binding AggregateStatus}" Margin="16,6,0,0" Foreground="{StaticResource AccentBrush}" FontSize="16"/>
            <ComboBox Width="140" Margin="24,0,0,0" ItemsSource="{Binding Tags}" Text="{Binding FilterTag, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />
            <Button Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Padding="12,4"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="#333">
            <TabItem Header="Overview">
                <DataGrid ItemsSource="{Binding Targets}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8"
                          Background="#1A1D24" Foreground="#E8E8E8" RowBackground="#1A1D24" AlternatingRowBackground="#22262E">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*"/>
                        <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Checks" Binding="{Binding CheckCount}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Targets">
                <StackPanel Margin="12">
                    <TextBlock Text="Add target" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Width="160" Margin="0,0,8,0" Text="{Binding NewTargetName, UpdateSourceTrigger=PropertyChanged}" Tag="Name"/>
                        <TextBox Width="200" Margin="0,0,8,0" Text="{Binding NewTargetHost, UpdateSourceTrigger=PropertyChanged}" Tag="Host"/>
                        <TextBox Width="120" Margin="0,0,8,0" Text="{Binding NewTargetTag, UpdateSourceTrigger=PropertyChanged}" Tag="Tag"/>
                        <Button Content="Add" Command="{Binding AddTargetCommand}" Padding="16,4"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Alerts">
                <DataGrid ItemsSource="{Binding RecentAlerts}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8"
                          Background="#1A1D24" Foreground="#E8E8E8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding FiredAtUtc}" Width="180"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Logs">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Clear view" Command="{Binding ClearLogsCommand}" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="Copy all" Command="{Binding CopyLogsToClipboardCommand}" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" Padding="10,4" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding LogFolderPath}" Foreground="#888" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding LogLines}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#1A1D24" Foreground="#E8E8E8" RowBackground="#1A1D24" AlternatingRowBackground="#22262E"
                              FontFamily="Consolas" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time (local)" Binding="{Binding LocalTime}" Width="175"/>
                            <DataGridTextColumn Header="Lvl" Binding="{Binding Level}" Width="44"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="220"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Discovery">
                <StackPanel Margin="12">
                    <TextBlock Text="Subnet scan pings hosts that reply to ICMP on IPv4. Leave CIDR empty to scan every connected subnet (Wi‑Fi, Ethernet, VPN); or enter e.g. 10.0.0.0/24. Only reachable addresses are listed—many devices block pings." Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Width="220" ToolTip="Leave blank for all connected IPv4 interfaces" Text="{Binding DiscoveryCidr, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Scan" Margin="8,0,0,0" Command="{Binding RunDiscoveryCommand}" Padding="12,4"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Settings">
                <StackPanel Margin="12">
                    <CheckBox Content="Enable trusted-LAN viewer (not real authentication)" IsChecked="{Binding LanViewerEnabled}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Port" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Width="40"/>
                        <TextBox Width="80" Text="{Binding LanViewerPort}"/>
                        <Button Content="Save LAN settings" Margin="12,0,0,0" Command="{Binding SaveLanSettingsCommand}" Padding="8,4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Export config" Command="{Binding ExportConfigCommand}" Margin="0,0,8,0" Padding="8,4"/>
                        <Button Content="Import config" Command="{Binding ImportConfigCommand}" Margin="0,0,8,0" Padding="8,4"/>
                        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" Padding="8,4"/>
                        <Button Content="Export HTML" Command="{Binding ExportHtmlCommand}" Margin="0,0,8,0" Padding="8,4"/>
                        <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,0" Padding="8,4"/>
                        <Button Content="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}" Padding="8,4"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#888" Margin="0,8,0,0"/>
    </Grid>
</Window>
