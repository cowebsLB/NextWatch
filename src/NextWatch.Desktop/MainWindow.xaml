<Window x:Class="NextWatch.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NextWatch.Desktop.Converters"
        Title="{Binding WindowTitle}"
        Height="760" Width="1200" MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:StatusToForegroundConverter x:Key="Conv.StatusFg"/>
        <conv:StatusToBackgroundConverter x:Key="Conv.StatusBg"/>
        <conv:StatusToBorderConverter x:Key="Conv.StatusBorder"/>
        <conv:LogLevelToForegroundConverter x:Key="Conv.LogLevelFg"/>

        <!-- Reusable status pill template -->
        <DataTemplate x:Key="StatusPillTemplate">
            <Border Style="{StaticResource Pill}"
                    Background="{Binding Status, Converter={StaticResource Conv.StatusBg}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                             VerticalAlignment="Center"
                             Fill="{Binding Status, Converter={StaticResource Conv.StatusFg}}"/>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{Binding Status, Converter={StaticResource Conv.StatusFg}}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource Sidebar.TabControl}" ItemContainerStyle="{StaticResource Sidebar.TabItem}">

        <!-- ============================================ OVERVIEW ============================================ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Overview" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <DockPanel LastChildFill="True">

                <!-- Top app bar -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Overview" Style="{StaticResource Text.Display}"/>
                            <TextBlock Text="Live status of every monitored target on this machine."
                                       Style="{StaticResource Text.Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Pill}"
                                    Background="{Binding AggregateStatus, Converter={StaticResource Conv.StatusBg}}"
                                    Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding AggregateStatus, Converter={StaticResource Conv.StatusFg}}"/>
                                    <TextBlock Text="{Binding AggregateStatus}"
                                               Foreground="{Binding AggregateStatus, Converter={StaticResource Conv.StatusFg}}"
                                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ComboBox Width="180" Margin="0,0,8,0"
                                      ItemsSource="{Binding Tags}"
                                      Text="{Binding FilterTag, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      ToolTip="Filter by tag"/>
                            <Button Content="Refresh" Style="{StaticResource Btn.Accent}"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Body -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">

                        <!-- KPI cards -->
                        <UniformGrid Columns="4" Rows="1">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TARGETS" Style="{StaticResource Text.Caption}"/>
                                    <TextBlock Text="{Binding TotalCount}" FontSize="30" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
                                    <TextBlock Text="monitored" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0,4,0"
                                    BorderBrush="{StaticResource Brush.Ok}">
                                <StackPanel>
                                    <TextBlock Text="HEALTHY" Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Brush.Ok}"/>
                                    <TextBlock Text="{Binding OkCount}" FontSize="30" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Ok}" Margin="0,4,0,0"/>
                                    <TextBlock Text="responding ok" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0,4,0"
                                    BorderBrush="{StaticResource Brush.Warn}">
                                <StackPanel>
                                    <TextBlock Text="WARNING" Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Brush.Warn}"/>
                                    <TextBlock Text="{Binding WarnCount}" FontSize="30" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Warn}" Margin="0,4,0,0"/>
                                    <TextBlock Text="degraded" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,0,0"
                                    BorderBrush="{StaticResource Brush.Down}">
                                <StackPanel>
                                    <TextBlock Text="DOWN" Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Brush.Down}"/>
                                    <TextBlock Text="{Binding DownCount}" FontSize="30" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Down}" Margin="0,4,0,0"/>
                                    <TextBlock Text="unreachable" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Targets table -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top" Padding="18,14"
                                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Targets" Style="{StaticResource Text.H2}"/>
                                        <TextBlock Text="{Binding TotalCount, StringFormat=' · {0} total'}"
                                                   Style="{StaticResource Text.Muted}" Margin="2,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataGrid ItemsSource="{Binding Targets}" Margin="0" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="HOST" Binding="{Binding Host}" Width="*"/>
                                        <DataGridTextColumn Header="TAG" Binding="{Binding Tag}" Width="140"/>
                                        <DataGridTemplateColumn Header="STATUS" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Pill}" Margin="0,5"
                                                            Background="{Binding Status, Converter={StaticResource Conv.StatusBg}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                     Fill="{Binding Status, Converter={StaticResource Conv.StatusFg}}"/>
                                                            <TextBlock Text="{Binding Status}"
                                                                       Foreground="{Binding Status, Converter={StaticResource Conv.StatusFg}}"
                                                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="CHECKS" Binding="{Binding CheckCount}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ============================================ TARGETS ============================================ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Targets" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <StackPanel>
                        <TextBlock Text="Targets" Style="{StaticResource Text.Display}"/>
                        <TextBlock Text="Add hosts and services. New HTTP targets get gateway-friendly defaults (200–399, 401, 403)."
                                   Style="{StaticResource Text.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Add a new target" Style="{StaticResource Text.H2}"/>
                                <TextBlock Text="Creates a Ping check (60s) and an HTTP check (120s) automatically."
                                           Style="{StaticResource Text.Muted}" Margin="0,4,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Host or URL" Style="{StaticResource Text.Caption}" Margin="10,0,0,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Tag (optional)" Style="{StaticResource Text.Caption}" Margin="10,0,0,6"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,5,0"
                                             Text="{Binding NewTargetName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="5,0,5,0"
                                             Text="{Binding NewTargetHost, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Margin="5,0,10,0"
                                             Text="{Binding NewTargetTag, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Row="1" Grid.Column="3" Content="Add target"
                                            Style="{StaticResource Btn.Accent}"
                                            Command="{Binding AddTargetCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ============================================ ALERTS ============================================ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Alerts" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <StackPanel>
                        <TextBlock Text="Alerts" Style="{StaticResource Text.Display}"/>
                        <TextBlock Text="Recent state-change events — alerts only fire on transitions, not every poll."
                                   Style="{StaticResource Text.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="24" Padding="0">
                    <DataGrid ItemsSource="{Binding RecentAlerts}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="WHEN (UTC)" Binding="{Binding FiredAtUtc, StringFormat=u}" Width="200"/>
                            <DataGridTemplateColumn Header="STATUS" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Pill}" Margin="0,5"
                                                Background="{Binding Status, Converter={StaticResource Conv.StatusBg}}">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding Status, Converter={StaticResource Conv.StatusFg}}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ============================================ DISCOVERY ============================================ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE773;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Discovery" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <StackPanel>
                        <TextBlock Text="Discovery" Style="{StaticResource Text.Display}"/>
                        <TextBlock Text="ICMP sweep across IPv4 subnets. Only hosts that reply to ping are listed."
                                   Style="{StaticResource Text.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- Manual scan card -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Scan a subnet" Style="{StaticResource Text.H2}"/>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,14" TextWrapping="Wrap"
                                           Text="Leave the CIDR empty to scan every connected IPv4 subnet (Wi‑Fi, Ethernet, VPN). Or pick a detected network from the list, or type one e.g. 192.168.1.0/24."/>
                                <TextBlock Text="CIDR" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="280" Margin="0,0,10,0"
                                             Text="{Binding DiscoveryCidr, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Scan now" Style="{StaticResource Btn.Accent}"
                                            Command="{Binding RunDiscoveryCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Detected networks card -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock Text="Detected IPv4 networks" Style="{StaticResource Text.H2}"/>
                                    <TextBlock Text="From adapters that are up. Click to use it." Style="{StaticResource Text.Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" Content="Refresh"
                                        Style="{StaticResource Btn.Subtle}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding RefreshDetectedNetworksCommand}"
                                        Margin="0,12,0,0"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                                    <ItemsControl ItemsSource="{Binding DetectedNetworks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Btn.Subtle}" Margin="0,3"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Content="{Binding DisplayLabel}"
                                                        Command="{Binding DataContext.ApplyDetectedNetworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Cidr}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ============================================ LOGS ============================================ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Logs" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Logs" Style="{StaticResource Text.Display}"/>
                            <TextBlock Text="{Binding LogFolderPath}" Style="{StaticResource Text.Muted}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Clear view" Style="{StaticResource Btn.Subtle}"
                                    Command="{Binding ClearLogsCommand}" Margin="0,0,8,0"/>
                            <Button Content="Copy all" Style="{StaticResource Btn.Subtle}"
                                    Command="{Binding CopyLogsToClipboardCommand}" Margin="0,0,8,0"/>
                            <Button Content="Open folder" Style="{StaticResource Btn.Accent}"
                                    Command="{Binding OpenLogsFolderCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="24" Padding="0">
                    <DataGrid ItemsSource="{Binding LogLines}" BorderThickness="0"
                              FontFamily="{StaticResource Font.Mono}" FontSize="12" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding LocalTime}" Width="180"/>
                            <DataGridTemplateColumn Header="LVL" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Level}" FontWeight="SemiBold"
                                                   Foreground="{Binding Level, Converter={StaticResource Conv.LogLevelFg}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="240"/>
                            <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ============================================ SETTINGS ============================================ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource Text.Display}"/>
                        <TextBlock Text="Local configuration. Nothing leaves this machine unless you explicitly export it."
                                   Style="{StaticResource Text.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">

                        <!-- LAN Viewer -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Trusted-LAN viewer" Style="{StaticResource Text.H2}"/>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,14" TextWrapping="Wrap"
                                           Text="Optional read-only HTTP dashboard for the local network. Uses a shared secret, not real auth — only enable on trusted networks."/>
                                <CheckBox Content="Enable trusted-LAN viewer"
                                          IsChecked="{Binding LanViewerEnabled}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Port" VerticalAlignment="Center" Width="60"
                                               Style="{StaticResource Text.Body}"/>
                                    <TextBox Width="100" Text="{Binding LanViewerPort}" Margin="0,0,12,0"/>
                                    <Button Content="Save" Style="{StaticResource Btn.Accent}"
                                            Command="{Binding SaveLanSettingsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Configuration -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Configuration" Style="{StaticResource Text.H2}"/>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,14"
                                           Text="Backup and restore your targets, checks, and rules. Secrets are stripped on export."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Export config" Style="{StaticResource Btn.Subtle}"
                                            Command="{Binding ExportConfigCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Import config" Style="{StaticResource Btn.Subtle}"
                                            Command="{Binding ImportConfigCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Reports -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Reports" Style="{StaticResource Text.H2}"/>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,14"
                                           Text="Snapshot the current state of monitoring."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Export CSV" Style="{StaticResource Btn.Subtle}"
                                            Command="{Binding ExportCsvCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Export HTML" Style="{StaticResource Btn.Subtle}"
                                            Command="{Binding ExportHtmlCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Export diagnostics zip" Style="{StaticResource Btn.Subtle}"
                                            Command="{Binding ExportDiagnosticsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,16">
                            <StackPanel>
                                <TextBlock Text="About" Style="{StaticResource Text.H2}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                                    <TextBlock Text="Version" Style="{StaticResource Text.Muted}" Width="80"/>
                                    <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Text.Body}"/>
                                </StackPanel>
                                <Button Content="Check for updates" Style="{StaticResource Btn.Accent}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding CheckForUpdatesCommand}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        </TabControl>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Muted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                             Fill="{Binding AggregateStatus, Converter={StaticResource Conv.StatusFg}}"/>
                    <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>
</Window>
