<Window x:Class="NextWatch.Desktop.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to NextWatch" Height="320" Width="480"
        WindowStartupLocation="CenterScreen" Background="#0F1115">
    <StackPanel Margin="24">
        <TextBlock Text="Welcome to NextWatch" FontSize="22" FontWeight="SemiBold" Foreground="#E8E8E8"/>
        <TextBlock Text="Local, simple network monitoring from your tray." Margin="0,8,0,16" Foreground="#AAA" TextWrapping="Wrap"/>
        <TextBlock Text="First host to monitor" Foreground="#E8E8E8"/>
        <TextBox x:Name="HostBox" Margin="0,4,0,16" Text="127.0.0.1" Padding="6"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Skip" Margin="0,0,8,0" Padding="16,6" Click="Skip_Click"/>
            <Button Content="Start monitoring" Padding="16,6" Click="Start_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
