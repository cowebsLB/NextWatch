<Application x:Class="NextWatch.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0F1115"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1D24"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    </Application.Resources>
</Application>
